# --- LLM / embeddings ---
LLM_MODEL=qwen3:14b
EMBEDDING_MODEL=all-mpnet-base-v2
EMBEDDING_BACKEND=tfidf
RERANKER_MODEL=none
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_S=180
LLM_NUM_PREDICT=600
# Concise UI default caps output tokens so CPU answers land in ~1-3 min; Detailed=1200.

# --- Retrieval tuning ---
TOPK_BM25=50
TOPK_DENSE=50
TOPK_GRAPH=20
FUSION_POOL=100
RERANK_POOL=60
FINAL_EVIDENCE=12
RRF_K=60
SEMANTIC_WEIGHT=0.55

# --- Stores ---
CANONICAL_DB=data/canonical/canonical.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=autosar_chunks
POSTGRES_DSN=postgresql://autosar:autosar@localhost:5432/autosar
NEO4J_URI=bolt://localhost:7687
NEO4J_AUTH=neo4j/autosar
REDIS_URL=redis://localhost:6379/0

# --- Rollback / migration ---
RAG_PIPELINE_VERSION=v2
# v1 = legacy text-only retrieval (ignores tables/figures stores, no clarification gate in /query)
# v2 = multimodal + staged chat workflow (default)

# --- Cloud LLM (OpenAI-compatible; optional) ---
# OPENAI_BASE_URL=https://api.openai.com/v1
# CLOUD_MODEL=gpt-4o-mini
# (API keys are entered in the UI per session and never stored.)

# --- Corpus ---
PDF_DIR=pdf
SUPPORTED_RELEASES=4.2.2,4.3.0,4.3.1,4.4.0,R19-11,R20-11,R21-11,R22-11,R23-11
